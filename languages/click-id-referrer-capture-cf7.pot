msgid "Storage mode"
msgstr ""

#: includes/class-cidrc-admin.php:217
msgid "Always store"
msgstr ""

#: includes/class-cidrc-admin.php:218
msgid "Wait for consent"
msgstr ""

#: includes/class-cidrc-admin.php:221
msgid "In wait for consent mode the values are held in the browser session only, and the cookie is written after consent is granted."
msgstr ""

#: includes/class-cidrc-admin.php:224
msgid "Cookie lifetime in days"
msgstr ""

#: includes/class-cidrc-admin.php:224
msgid "Between 1 and 400 days. Google Ads offline conversions accept a click up to 90 days old by default."
msgstr ""

#: includes/class-cidrc-admin.php:226
msgid "Consent cookie name"
msgstr ""

#: includes/class-cidrc-admin.php:226
msgid "Optional. Examples: cookieyes-consent for CookieYes, CookieConsent for Cookiebot, cmplz_marketing for Complianz."
msgstr ""

#: includes/class-cidrc-admin.php:228
msgid "Consent cookie contains"
msgstr ""

#: includes/class-cidrc-admin.php:228
msgid "Optional. The cookie is written once the consent cookie contains this text. Examples: advertisement:yes for CookieYes, marketing:true for Cookiebot, allow for Complianz."
msgstr ""

#: includes/class-cidrc-admin.php:230
msgid "Extended attribution"
msgstr ""

#: includes/class-cidrc-admin.php:230
msgid "Records first and last touch for every UTM, the referrer, landing page and channel of each touch, and the page the form was submitted from. Adds these to the email summary, the submission log, the full CSV and the webhook."
msgstr ""

#: includes/class-cidrc-admin.php:234
msgid "Contact Form 7"
msgstr ""

#: includes/class-cidrc-admin.php:237
msgid "Append attribution summary to every Contact Form 7 mail body automatically"
msgstr ""

#: includes/class-cidrc-admin.php:237
msgid "Leave this off if you prefer to place the [cidrc_summary] mail tag yourself."
msgstr ""

#: includes/class-cidrc-admin.php:239
msgid "Keep a submission log"
msgstr ""

#: includes/class-cidrc-admin.php:239
msgid "Stores one row per sent form, with hashed contact details, so that you can export offline conversions later."
msgstr ""

#: includes/class-cidrc-admin.php:241
msgid "Log retention in days"
msgstr ""

#: includes/class-cidrc-admin.php:241
msgid "Rows older than this are deleted once a day. Set 0 to keep rows for ever."
msgstr ""

#: includes/class-cidrc-admin.php:245
msgid "Offline conversions"
msgstr ""

#: includes/class-cidrc-admin.php:248
msgid "Default conversion name"
msgstr ""

#: includes/class-cidrc-admin.php:248
msgid "This has to match the conversion action name in Google Ads or Microsoft Advertising exactly."
msgstr ""

#: includes/class-cidrc-admin.php:250
msgid "Default conversion value"
msgstr ""

#: includes/class-cidrc-admin.php:250
msgid "A number, for example 250. Use 0 if you do not report a value."
msgstr ""

#: includes/class-cidrc-admin.php:252
msgid "Currency code"
msgstr ""

#: includes/class-cidrc-admin.php:252
msgid "Three letters, for example GBP, EUR or USD."
msgstr ""

#: includes/class-cidrc-admin.php:254
msgid "Per form overrides"
msgstr ""

#: includes/class-cidrc-admin.php:254
msgid "One line per form, in the format: form ID | conversion name | conversion value. The value is optional."
msgstr ""

#: includes/class-cidrc-admin.php:258
msgid "Consent fallback"
msgstr ""

#: includes/class-cidrc-admin.php:260
msgid "Leave blank (unspecified)"
msgstr ""

