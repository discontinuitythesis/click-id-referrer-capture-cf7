msgstr ""

#: includes/class-cidrc-admin.php:277
msgid "Webhook secret"
msgstr ""

#: includes/class-cidrc-admin.php:277
msgid "Optional. Sent as the X-CIDRC-Secret request header so that your endpoint can reject anything else."
msgstr ""

#: includes/class-cidrc-admin.php:279
msgid "Include the raw email address in the webhook"
msgstr ""

#: includes/class-cidrc-admin.php:279
msgid "Off by default. Only turn this on when your privacy notice covers sending personal data to that endpoint, and only when the endpoint is under your control."
msgstr ""

