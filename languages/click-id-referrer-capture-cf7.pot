msgid "Denied"
msgstr ""

#: includes/class-cidrc-admin.php:265
msgid "Used only when no Google Consent Mode signal is found on the page at submission. Leave blank unless your consent banner records this consent for every lead."
msgstr ""

#: includes/class-cidrc-admin.php:268
msgid "Include GBRAID and WBRAID columns in the Google Ads export"
msgstr ""

#: includes/class-cidrc-admin.php:268
msgid "Adds GBRAID and WBRAID columns. Google's file import template documents Google Click ID only; enable this if your import route accepts them."
msgstr ""

